Package: enzKinet2
Title: Models for Enzyme Kinetic Analysis
Version: 2.0.7
Authors@R: c(
    person("Haig", "Bishop", email = "haigvbishop@gmail.com",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0003-4118-3598")),
    person("Daniel", "Mak", role = "aut",
           comment = c(ORCID = "0000-0002-3355-0696")),
